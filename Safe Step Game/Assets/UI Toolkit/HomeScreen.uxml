<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/main.uss?fileID=7433441132597879392&amp;guid=60d635056be59a645bf843413e36fbfa&amp;type=3" />
    <Style src="project://database/Assets/UI%20Toolkit/menu-style.uss?fileID=7433441132597879392&amp;guid=21574db30d79cda4dbd76a257f0ccd0a&amp;type=3" />
    <Style src="project://database/Assets/color-style.uss?fileID=7433441132597879392&amp;guid=163ed8835a7608144b5fb26da4167f35&amp;type=3" />
    <Style src="project://database/Assets/command-state.uss?fileID=7433441132597879392&amp;guid=290de5c356eda4f44b5cfe7b2b8d7af7&amp;type=3" />
    <ui:VisualElement name="root-container" style="flex-grow: 1; flex-direction: column; flex-wrap: nowrap; align-content: auto; align-self: auto; align-items: stretch;">
        <ui:VisualElement name="header" style="flex-grow: 1; max-height: 167px; position: absolute; top: 0; left: 0; right: 0; bottom: auto;">
            <ui:VisualElement name="header-container">
                <ui:VisualElement style="flex-grow: 1; position: absolute; height: 120px; background-color: rgb(255, 255, 255); top: 0; right: 0; left: 0; bottom: 0; align-self: center; align-items: flex-start; justify-content: center; margin-top: 0; border-bottom-right-radius: 40px; border-bottom-left-radius: 40px; max-height: initial; max-width: none;">
                    <ui:VisualElement name="container-name" style="flex-grow: 1; align-items: flex-start; justify-content: center; position: relative; left: 10%;">
                        <ui:Label text="Selamat Datang!" name="head-greet" style="font-size: 24%; color: rgb(87, 147, 221);" />
                        <ui:Label text="Aleena Armstrong" name="player-name" style="font-size: 28%; color: rgb(87, 147, 221); margin-top: -16px;" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="player-avatar" style="position: absolute; right: 10%; height: 180px; width: 180px; -unity-background-image-tint-color: rgb(255, 255, 255); background-color: rgb(87, 147, 221); background-image: url(&quot;project://database/Assets/Images/Avatar/Protag%20Cewek.png?fileID=2800000&amp;guid=3934d9293cda28c4b9cee9198d7150c4&amp;type=3#Protag Cewek&quot;); border-top-left-radius: 50%; border-top-right-radius: 50%; border-bottom-right-radius: 50%; border-bottom-left-radius: 50%; border-top-width: 9px; border-right-width: 9px; border-bottom-width: 9px; border-left-width: 9px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); background-size: 80% 80%; -unity-background-scale-mode: stretch-to-fill; background-position-x: center 20px; background-position-y: top 20px;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="menu-space" style="width: 80%; height: 60%; position: relative; top: 20%; left: auto; right: auto; bottom: 20%; align-items: stretch; align-self: center; border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; background-color: rgba(227, 99, 222, 0); max-height: 60%; margin-top: 1%; margin-right: 1%; margin-bottom: 1%; margin-left: 1%;">
            <ui:VisualElement name="home-menu" class="menu-field common-show" style="background-color: rgba(255, 255, 255, 0); flex-direction: row-reverse; justify-content: center;">
                <ui:VisualElement name="game-card-container" style="flex-grow: 1; background-color: rgb(255, 255, 255); border-top-left-radius: 21px; border-top-right-radius: 21px; border-bottom-right-radius: 21px; border-bottom-left-radius: 21px; max-width: 480px; max-height: 1080px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 8px; border-left-width: 1px; border-left-color: rgb(182, 182, 182); border-right-color: rgb(182, 182, 182); border-top-color: rgb(182, 182, 182); border-bottom-color: rgb(182, 182, 182); display: none; flex-direction: row;">
                    <ui:VisualElement name="safegame-label" style="flex-grow: 1; background-color: rgb(236, 80, 224); height: 30%; min-height: 45px; max-height: 12%; margin-top: 18px; margin-right: 18px; margin-bottom: 18px; margin-left: 18px; align-items: center; flex-direction: row; align-self: auto; justify-content: center;">
                        <ui:Label text="SafeGame!" style="align-items: center; align-self: center; -unity-text-align: upper-center; justify-content: center; color: rgb(255, 255, 255); font-size: 34px;" />
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-grow: 1; background-color: rgb(122, 122, 122); margin-top: 18px; margin-right: 18px; margin-bottom: 18px; margin-left: 18px; max-height: 343px;" />
                </ui:VisualElement>
                <ui:VisualElement name="gamecard" class="menu-gamecard" style="background-image: url(&quot;project://database/Assets/Images/g67.png?fileID=2800000&amp;guid=40c661b45b762fd46946cea355c8fa27&amp;type=3#g67&quot;); background-size: contain; max-width: 80%; top: 0; bottom: 0; right: 10%; left: 10%; position: absolute; align-self: auto; flex-wrap: nowrap;">
                    <ui:Button name="gamecard-button" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
                </ui:VisualElement>
                <ui:Button text="&#10;" name="gamepick-right" class="gamepickbutton" style="background-image: url(&quot;project://database/Assets/Images/UI/arrow_right.png?fileID=2800000&amp;guid=f0320385fcebd834f867701b6633685e&amp;type=3#arrow_right&quot;); background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; right: 0;" />
                <ui:Button name="gamepick-left" class="gamepickbutton" style="left: 0; background-image: url(&quot;project://database/Assets/Images/UI/g50.png?fileID=2800000&amp;guid=605a76f62934f4a4bbacb243a3ceed15&amp;type=3#g50&quot;);" />
            </ui:VisualElement>
            <ui:VisualElement name="progress-menu" class="menu-field">
                <ui:Label text="SafeQuiz" class="label-progress" />
                <ui:ProgressBar value="0" name="progress-lv1" class="level-progressbar" />
                <ui:Label text="SafeAction" class="label-progress" />
                <ui:ProgressBar value="0" name="progress-lv2" class="level-progressbar" />
                <ui:Label text="SafeMind" class="label-progress" />
                <ui:ProgressBar value="0" name="progress-lv3" class="level-progressbar" />
                <ui:Label text="Total Progress Kamu :" name="Label" class="label-progress" style="-unity-text-align: upper-center; font-size: 45px;" />
                <ui:ProgressBar value="0" name="progress-total" class="level-progressbar" />
                <ui:VisualElement name="spacer" style="height: 77px;" />
                <ui:VisualElement style="flex-grow: 1;">
                    <ui:VisualElement style="flex-grow: 1;">
                        <ui:Label text="Selesaikan semua progress game untuk mendapatkan sertifikat kamu!" style="align-self: center; color: rgb(87, 147, 221); font-size: 16px; white-space: normal; -unity-text-align: upper-center; -unity-font-style: normal;" />
                        <ui:VisualElement name="SertifStuff" class="sertif-disabled" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/CertificateRenderTex.renderTexture?fileID=8400000&amp;guid=9e8091124418ab9459fe271098324579&amp;type=2#CertificateRenderTex&quot;); -unity-background-scale-mode: scale-to-fit; margin-top: 9px; margin-right: 9px; margin-bottom: 9px; margin-left: 9px; background-size: cover; border-top-left-radius: 18px; border-top-right-radius: 18px; border-bottom-right-radius: 18px; border-bottom-left-radius: 18px;" />
                        <ui:Button text="Klaim Sertifikat!" enabled="false" name="SertifClaimButton" class="menu-button" style="visibility: visible; opacity: 1;" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="profile-menu" class="menu-field" style="overflow: visible; visibility: visible;">
                <ui:Button text="Ubah Nama" name="profile-change-name" class="menu-button button-blue" />
                <ui:Button text="Ubah Avatar" name="profile-change-avatar" class="menu-button button-blue" />
                <ui:Button text="Ekspor Data" name="profile-export-data" class="menu-button button-blue" style="height: 90px; display: none;" />
                <ui:Button text="Reset Progress" name="profile-logout" class="menu-button" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="navbar" style="flex-grow: 1; bottom: 0; flex-direction: row; align-content: center; align-self: center; justify-content: space-around; align-items: center; min-width: 240px; -unity-background-image-tint-color: rgb(255, 255, 255); background-color: rgb(255, 118, 228); padding-top: 23px; padding-right: 16px; padding-bottom: 16px; padding-left: 16px; border-top-width: 8px; border-top-color: rgb(255, 255, 255); max-width: 80%; border-top-right-radius: 42px; border-top-left-radius: 42px; border-right-width: 8px; border-left-width: 8px; border-right-color: rgb(255, 255, 255); border-left-color: rgb(255, 255, 255); width: 100%; max-height: 12%; position: absolute; height: 120px; border-bottom-width: 8px;">
            <ui:Button name="nav-home" class="nav-button navisSelected" style="background-image: url(&quot;project://database/Assets/Images/UI/white-home.png?fileID=2800000&amp;guid=3df9b344891bcb241a7c0bccd6f9e1a9&amp;type=3#white-home&quot;);" />
            <ui:Button name="nav-progress" class="nav-button" style="background-image: url(&quot;project://database/Assets/Images/UI/white-progress.png?fileID=2800000&amp;guid=9d9658eff613e6e48a08e75600c9b280&amp;type=3#white-progress&quot;);" />
            <ui:Button name="nav-profile" class="nav-button" style="background-image: url(&quot;project://database/Assets/Images/UI/white-profile.png?fileID=2800000&amp;guid=d39d535a980201e4e953247a9549a557&amp;type=3#white-profile&quot;);" />
        </ui:VisualElement>
        <ui:VisualElement name="pop-up-overlay" class="hide-popup" style="flex-grow: 1; position: absolute; top: 0; left: 0; right: 1px; bottom: 2px; -unity-text-outline-color: rgb(255, 39, 39); background-color: rgba(128, 128, 128, 0.79); align-self: auto; align-content: auto; justify-content: center; transition-duration: 0.2s; transition-property: scale; display: flex;">
            <ui:VisualElement style="flex-grow: 1; align-items: center; justify-content: center; background-color: rgba(255, 255, 255, 0); align-self: center; background-image: url(&quot;project://database/Assets/UI%20Toolkit/rect8.png?fileID=2800000&amp;guid=c7b0fa7b2c9c25449b7e872c7e1ffebf&amp;type=3#rect8&quot;); -unity-slice-left: 33; -unity-slice-top: 33; -unity-slice-right: 33; -unity-slice-bottom: 33; max-height: 216px; min-height: 256px; min-width: 255px; -unity-background-image-tint-color: rgb(255, 255, 255); transition-duration: 0.5s;">
                <ui:VisualElement name="VisualElement">
                    <ui:Button text="Button" />
                </ui:VisualElement>
                <ui:Label text="Label" />
                <ui:VisualElement name="VisualElement" style="flex-direction: row;">
                    <ui:Button text="Yes" name="pop-yes" class="popup-button button-blue" />
                    <ui:Button text="No" name="pop-no" class="popup-button" />
                    <ui:Button text="Button" name="switchTest" class="switch-off" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
